# Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.6-27b

# Tran output token moi request. Goi Groq free gioi han OTPM = 1000, dat cao hon se bi tu choi.
GROQ_MAX_TOKENS=800

# Tat thinking cua qwen3.6 (reasoning token tinh vao output, an het tran token)
GROQ_REASONING_EFFORT=none

# Google Apps Script Web App (URL ket thuc bang /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec

# Chuoi ngau nhien, phai GIONG HET Script Property SHARED_SECRET ben Apps Script
SHARED_SECRET=

# Tuy chon: mat khau don gian de nguoi la khong dung duoc web app
APP_PASSWORD=
